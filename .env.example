# Optional Hub sandbox configuration; empty means pending publication.
MORPH_HUB_URL=
MORPH_HUB_TOKEN=
# Local runtime data must remain outside version control.
MORPH_RUNTIME_DIR=.runtime
# Readiness probes: interfaces and accounts stay not_run until declared here.
# Print a reference manifest with: python -m readiness --example-manifest
MORPH_READINESS_MANIFEST=
MORPH_READINESS_LOCAL=1
MORPH_READINESS_DISABLE=
MORPH_READINESS_CACHE_SECONDS=60
MORPH_READINESS_BUDGET_SECONDS=45
