# Default deny: no .git, credentials, env files, caches or runtime evidence.
**
!pyproject.toml
!poetry.lock
!package.json
!package-lock.json
!LICENSE
!THIRD_PARTY_NOTICES.md
!contracts/
!contracts/**/*.py
!persistence/
!persistence/**/*.py
!bootstrap/
!bootstrap/**/*.py
!bridge_node/
!bridge_node/**/*.py
!hub_client/
!hub_client/**/*.py
!orca_provision/
!orca_provision/**/*.py
!orchestration/
!orchestration/**/*.py
!topology/
!topology/**/*.py
!metabolism/
!metabolism/**/*.py
!mocks/
!mocks/**/*.py
!viz/
!viz/*.py
!viz/static/
!viz/static/index.html
!viz/static/app.js
!viz/static/style.css
!viz/static/assets/
!viz/static/assets/finals-shell.js
!viz/static/assets/finals-shell.css
!viz/static/fonts/
!viz/static/fonts/Jost-latin.woff2
!viz/static/fonts/InterVariable.woff2
!viz/static/licenses/
!viz/static/licenses/**
!demo/
!demo/data/
!demo/data/mock-run.json
!deploy/
!deploy/Dockerfile
!deploy/Dockerfile.dockerignore
!deploy/nginx.conf
!deploy/proxy.conf
!deploy/healthcheck.py
# Even an accidentally copied file inside static must not enter the context.
**/.env*
**/.git/**
**/*.pem
**/*.key
**/*.map
**/__pycache__/**
