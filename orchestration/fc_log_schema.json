          "default": 0.0,
          "minimum": 0,
          "title": "Weight",
          "type": "number"
        },
        "flow": {
          "default": 0.0,
          "minimum": 0,
          "title": "Flow",
          "type": "number"
        },
        "success_rate": {
          "default": 0.5,
